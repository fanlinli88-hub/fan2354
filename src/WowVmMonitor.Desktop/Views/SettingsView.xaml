<UserControl x:Class="WowVmMonitor.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10">
            <TextBlock Text="Interval (s)" VerticalAlignment="Center" />
            <TextBox Text="{Binding CheckIntervalSeconds}" Width="70" Margin="6,0,16,0" />
            <TextBlock Text="Timeout (s)" VerticalAlignment="Center" />
            <TextBox Text="{Binding CheckTimeoutSeconds}" Width="70" Margin="6,0,16,0" />
            <TextBlock Text="Warning (s)" VerticalAlignment="Center" />
            <TextBox Text="{Binding WarningAfterSeconds}" Width="70" Margin="6,0,16,0" />
            <TextBlock Text="Alert (s)" VerticalAlignment="Center" />
            <TextBox Text="{Binding AlertAfterSeconds}" Width="70" Margin="6,0,0,0" />
        </WrapPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Machines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding DisplayName}" Margin="4,0" />
                            <TextBox Grid.Column="2" Text="{Binding SharePath}" Margin="4,0" />
                            <TextBox Grid.Column="3" Text="{Binding Username}" Margin="4,0" ToolTip="Username; blank password leaves credentials unchanged" />
                            <PasswordBox Grid.Column="4" Margin="4,0" PasswordChanged="OnPasswordChanged" ToolTip="Blank keeps the existing password" />
                            <Button Grid.Column="5" Content="Remove" Command="{Binding DataContext.RemoveMachineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="4,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Add Machine" Command="{Binding AddMachineCommand}" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="100" />
            <TextBlock Text="{Binding StatusMessage}" Margin="16,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
