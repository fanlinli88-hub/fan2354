<UserControl x:Class="WowVmMonitor.Desktop.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="开始监控" Command="{Binding StartCommand}" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="停止监控" Command="{Binding StopCommand}" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="立即检测" Command="{Binding CheckOnceCommand}" MinWidth="100" />
            <TextBlock Margin="24,4,0,0" Text="{Binding LastCompletedCheckText, StringFormat=最近检测：{0}}" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Machines}" AutoGenerateColumns="False"
                  IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="机器" Binding="{Binding DisplayName}" Width="140" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="120" />
                <DataGridTextColumn Header="共享路径" Binding="{Binding SharePath}" Width="220" />
                <DataGridTextColumn Header="最新日志" Binding="{Binding LatestLogPath}" Width="*" />
                <DataGridTextColumn Header="日志时间" Binding="{Binding LastWriteTimeText}" Width="160" />
                <DataGridTextColumn Header="日志年龄" Binding="{Binding LogAge}" Width="110" />
                <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorCode}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
