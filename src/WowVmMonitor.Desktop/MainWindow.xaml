<Window x:Class="WowVmMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WowVmMonitor.Desktop.Views"
        Title="WowVmMonitor" Height="680" Width="1120"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="Status">
                <views:StatusView DataContext="{Binding Dashboard}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem Header="Incident History">
                <views:IncidentHistoryView DataContext="{Binding History}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
