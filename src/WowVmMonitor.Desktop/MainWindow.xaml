<Window x:Class="WowVmMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WowVmMonitor.Desktop.Views"
        Title="魔兽世界日志监控" Height="680" Width="1120"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="监控状态">
                <views:StatusView DataContext="{Binding Dashboard}" />
            </TabItem>
            <TabItem Header="设置">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem Header="异常历史">
                <views:IncidentHistoryView DataContext="{Binding History}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
